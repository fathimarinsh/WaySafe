# =====================================================================
# WaySafe Project Environment Example
# =====================================================================
# Backend Environment (backend/.env)
# =====================================================================
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:3000

# Supabase Project URL & Keys (from https://supabase.com/dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Set to true for running offline unit/acceptance test suites
ALLOW_DEV_MOCK_AUTH=true

# =====================================================================
# Frontend Configuration (frontend/js/supabase-config.js)
# =====================================================================
# In frontend/js/supabase-config.js:
# export const SUPABASE_URL = 'https://your-project-id.supabase.co';
# export const SUPABASE_ANON_KEY = 'your-supabase-anon-key';
# NOTE: The service_role key must NEVER be placed in frontend code.
