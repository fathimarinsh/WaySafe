# =====================================================================
# WaySafe Backend - Environment Configuration
# =====================================================================
# Copy this file to .env and fill in your actual Supabase credentials.
# NEVER commit .env or secrets to version control.
# =====================================================================

# Server Port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# Allowed Frontend Origins (CORS)
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:3000

# =====================================================================
# Supabase Configuration
# =====================================================================
# Found in: Supabase Dashboard -> Project Settings -> API
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Publishable anon key (safe for browser and authenticated user API calls)
# Found in: Supabase Dashboard -> Project Settings -> API -> anon public
SUPABASE_ANON_KEY=your-supabase-anon-key

# Secret Service Role Key (Backend ONLY - bypasses RLS policies)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role secret
# WARNING: NEVER expose this key in frontend code, client repos, or browser scripts.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Development Mock Auth (Set to false in production)
# When true, permits mock tokens (mock-token-*) for running offline automated tests
ALLOW_DEV_MOCK_AUTH=true
